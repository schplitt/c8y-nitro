{
  "name": "c8y-nitro",
  "version": "0.11.2",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "description": "Lightning fast Cumulocity IoT microservice development powered by Nitro",
  "keywords": [
    "cumulocity",
    "c8y",
    "microservice",
    "nitro",
    "typescript",
    "iot",
    "docker"
  ],
  "license": "MIT",
  "author": "schplitt",
  "homepage": "https://github.com/schplitt/c8y-nitro#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/schplitt/c8y-nitro.git"
  },
  "bugs": {
    "url": "https://github.com/schplitt/c8y-nitro/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli/index.mjs",
    "./testing": "./dist/testing.mjs",
    "./testing/setup": "./dist/testing/setup.mjs",
    "./testing/vite": "./dist/testing/vite.mjs",
    "./types": "./dist/types.mjs",
    "./utils": "./dist/utils.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "c8y-nitro": "./dist/cli/index.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "gen:roles": "node scripts/generate-roles.ts",
    "gen:testing-capabilities": "node scripts/generate-testing-capabilities.ts",
    "build": "tsdown",
    "build:update": "tsdown --update-snapshot",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "prerelease": "eslint && tsc --noEmit && tsdown && vitest run",
    "release": "bumpp",
    "test": "vitest",
    "test:run": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "c12": "catalog:",
    "c8y-realtime": "catalog:",
    "citty": "catalog:",
    "consola": "catalog:",
    "croner": "catalog:",
    "evlog": "catalog:",
    "itty-time": "catalog:",
    "jszip": "catalog:",
    "pathe": "catalog:",
    "pkg-types": "catalog:",
    "spinnies": "catalog:",
    "tinyexec": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@c8y/client": "catalog:",
    "@schplitt/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@types/spinnies": "catalog:",
    "@types/ws": "catalog:",
    "bumpp": "catalog:",
    "changelogithub": "catalog:",
    "eslint": "catalog:",
    "memfs": "catalog:",
    "rolldown": "catalog:",
    "tsdown": "catalog:",
    "tsnapi": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@c8y/client": ">=1021",
    "nitro": "3.0.261103-rc",
    "vite": "^7.0.0 || ^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
